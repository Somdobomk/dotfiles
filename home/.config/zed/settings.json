// Zed settings

{
	"agent_ui_font_family": "GeistMono Nerd Font",
 "agent_buffer_font_size": 16.0,
 "agent_ui_font_size": 16.0,
 "agent_servers": {
  "claude-acp": {
   "default_config_options": {
    "mode": "auto"
   },
   "type": "registry"
  }
 },
 "context_servers": {
  
 },
 "edit_predictions": {
  "allow_data_collection": "no"
 },
 "collaboration_panel": {
  "dock": "left"
 },
 "outline_panel": {
  "dock": "left"
 },
 "git_panel": {
  "dock": "left"
 },
 "agent": {
  "enable_feedback": false,
  "dock": "right",
  "threads_sidebar": {
   "position": "right"
  },
  "favorite_models": [],
  "model_parameters": []
 },
 "window_title_format": "${projectName}${separator}${fileName}",
 "telemetry": {
  "diagnostics": false,
  "metrics": false,
  "anthropic_retention": false
 },
 "on_new_window": "empty_tab",
 "theme": "Everforest Dark Hard (material)",
	"buffer_font_family": "GeistMono Nerd Font",
	"buffer_font_size": 16,
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 16,
	"icon_theme": "Colored Zed Icons Theme Dark",
	"base_keymap": "VSCode",
	// "vim_mode": true,
	"buffer_line_height": { "custom": 1.4 },
	"buffer_font_features": { "calt": false },
	"buffer_font_weight": 300,
	"toolbar": { "breadcrumbs": false, "quick_actions": false },
	"project_panel": { "dock": "left",
                    "entry_spacing": "standard" },
	"tabs": { "file_icons": true },
	"git": { "inline_blame": { "enabled": false } },
	"current_line_highlight": "none",
	"format_on_save": "on",
	"tab_size": 4,
	"hard_tabs": true,
	"cursor_shape": "block",
}
