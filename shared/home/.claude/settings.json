{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "small-business@synced": false,
    "cc-plugin-telemetry@builtin": false,
    "sales@synced": false,
    "productivity@synced": false,
    "product-management@synced": false,
    "marketing@synced": false,
    "liquid-skills@synced": false,
    "operations@synced": false,
    "input-router@token-saving-mods": true,
    "effort-optimizer@token-saving-mods": true,
    "model-router@token-saving-mods": true,
    "cache-clock@token-saving-mods": true,
    "handoff@token-saving-mods": true,
    "research-router@token-saving-mods": true,
    "efficient-browser-use@token-saving-mods": true,
    "mods@token-saving-mods": true,
    "savings-proof@token-saving-mods": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "token-saving-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/david/Library/Mobile Documents/com~apple~CloudDocs/Downloads/token-saving-mods"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "theme": "dark-ansi",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
